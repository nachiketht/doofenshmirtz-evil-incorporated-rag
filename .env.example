# Copy to .env (gitignored) and fill in. Every value can also be an env var.

# --- Secrets -------------------------------------------------------------
COHERE_API_KEY=your-cohere-key
PINECONE_API_KEY=your-pinecone-key

# Restricted-document passphrase: exactly 6 letters, case-sensitive.
# Prefix a question with it ("ABCDEF: ...") to search top-secret documents.
# Leave empty to keep top-secret documents unreachable.
RAG_ACCESS_PHRASE=

# --- Vector store --------------------------------------------------------
RAG_DB_BACKEND=chroma            # chroma | pinecone
RAG_CHROMA_PATH=chroma
PINECONE_INDEX=doofenshmirtz-policies
PINECONE_NAMESPACE=dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Ingest --------------------------------------------------------------
RAG_CHUNKER=structural           # structural | recursive | parent_child | contextual | table_aware
RAG_METADATA_EXTRACTOR=heuristic # heuristic | llm

# --- Retrieval -----------------------------------------------------------
RAG_RERANKER=cohere              # cohere | local | ensemble | none (falls back automatically)
RAG_LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
RAG_TOP_N=3
RAG_CANDIDATE_K=50
RAG_FUSE_N=20
RAG_MULTI_QUERY=1
RAG_NUM_QUERIES=3
RAG_MMR=1
RAG_MMR_LAMBDA=0.7
RAG_SELF_CORRECT=1
RAG_MIN_COSINE=0.3
RAG_MIN_RERANK_SCORE=0.1
RAG_LOST_IN_MIDDLE=1
RAG_EXPAND_PARENTS=1
# RAG_AS_OF=2025-06-01           # answer as of a date (point-in-time)

# Matryoshka two-stage search: 0 = off; 128 | 256 | 512 for embeddinggemma
RAG_MRL_DIMS=0
RAG_MRL_PREFETCH=100

# --- Semantic cache (stored in .rag/) ------------------------------------
RAG_CACHE=1
RAG_CACHE_MAX=256
RAG_CACHE_TTL=86400
RAG_CACHE_THRESHOLD=0.95
